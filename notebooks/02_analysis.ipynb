   "source": [
    "import pandas as pd\n",
    "import statsmodels.api as sm\n",
    "df = pd.read_csv(\"data/processed/analysis_data.csv\")\n",
    "X = sm.add_constant(df[\"study_hours\"])\n",
    "model = sm.OLS(df[\"exam_score\"], X).fit()\n",
    "print(model.summary())\n"
   ]
  }
